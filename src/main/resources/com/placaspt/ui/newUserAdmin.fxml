<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.placaspt.ui.NewUserAdmin"
            prefWidth="600" prefHeight="400">

   <!-- Centro: formulario centrado -->
   <center>
      <GridPane alignment="CENTER"
                hgap="10" vgap="10">

         <!-- Margen interno -->
         <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
         </padding>

         <!-- Columnas: Etiqueta1, Campo1, Etiqueta2, Campo2 -->
         <columnConstraints>
            <ColumnConstraints percentWidth="15" halignment="RIGHT"/>
            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="15" halignment="RIGHT"/>
            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
         </columnConstraints>
         <!-- Filas: título, clave maestra, nombre/apellido, correo/teléfono, contraseña/confirmar, botones -->
         <rowConstraints>
            <RowConstraints percentHeight="15"/>
            <RowConstraints percentHeight="15"/>
            <RowConstraints percentHeight="15"/>
            <RowConstraints percentHeight="15"/>
            <RowConstraints percentHeight="15"/>
            <RowConstraints percentHeight="25"/>
         </rowConstraints>

         <!-- Fila 0: título centrado -->
         <Label text="Nuevo Administrador"
                GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="4"
                style="-fx-font-size: 18px; -fx-font-weight: bold;"
                GridPane.halignment="CENTER"/>

         <!-- Fila 1: clave maestra -->
         <Label text="Clave Maestra:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
         <TextField fx:id="claveMaestraField"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"/>

         <!-- Fila 2: nombre / apellido -->
         <Label text="Nombre:"           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
         <TextField fx:id="adminName"    GridPane.rowIndex="2" GridPane.columnIndex="1"/>
         <Label text="Apellido:"         GridPane.rowIndex="2" GridPane.columnIndex="2"/>
         <TextField fx:id="adminSurname" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

         <!-- Fila 3: correo / teléfono -->
         <Label text="Correo:"          GridPane.rowIndex="3" GridPane.columnIndex="0"/>
         <TextField fx:id="adminEmail"  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
         <Label text="Teléfono:"        GridPane.rowIndex="3" GridPane.columnIndex="2"/>
         <TextField fx:id="adminPhone"  GridPane.rowIndex="3" GridPane.columnIndex="3"/>

         <!-- Fila 4: contraseña / confirmar -->
         <Label text="Contraseña:"              GridPane.rowIndex="4" GridPane.columnIndex="0"/>
         <TextField fx:id="adminPassword"      GridPane.rowIndex="4" GridPane.columnIndex="1"/>
         <Label text="Confirmar Contraseña:"   GridPane.rowIndex="4" GridPane.columnIndex="2"/>
         <TextField fx:id="confirmAdminPassword"
                    GridPane.rowIndex="4" GridPane.columnIndex="3"/>

         <!-- Fila 5: botones centrados -->
         <HBox spacing="15" alignment="CENTER"
               GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <Button text="Crear Usuario" onAction="#crearUsuario"/>
            <Button text="Regresar"       onAction="#volverAlLogin"/>
         </HBox>
      </GridPane>
   </center>
</BorderPane>
