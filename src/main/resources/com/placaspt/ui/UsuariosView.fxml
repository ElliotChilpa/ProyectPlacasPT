<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.placaspt.ui.UsuariosController">

    <!-- Barra superior con filtros -->
    <HBox spacing="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
        <TextField fx:id="txtFiltro" promptText="Filtrar por nombre o correo…" />
        <ChoiceBox fx:id="cbTipo" prefWidth="150.0" />
        <Button fx:id="btnAgregarUsuarios" onAction="#onNuevoUsuario" text="+ Nuevo Usuario" />
    </HBox>

    <!-- Tabla, anclada para crecer con la ventana -->
    <TableView fx:id="tblUsuarios" layoutX="11.2" prefHeight="310.0" prefWidth="778.0" AnchorPane.bottomAnchor="130.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="11.0" AnchorPane.topAnchor="60.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colCorreo" prefWidth="150.0" text="Correo" />
            <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
            <TableColumn fx:id="colRfid" prefWidth="150.0" text="RFID" />
            <TableColumn fx:id="colPlaca" prefWidth="100.0" text="Placa" />
            <TableColumn fx:id="colAccion" prefWidth="80.0" text="Acciones" />
        </columns>
    </TableView>

</AnchorPane>
