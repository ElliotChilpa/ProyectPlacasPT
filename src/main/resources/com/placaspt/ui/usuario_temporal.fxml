<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.placaspt.ui.UsuarioTemporalController"
      spacing="15"
      alignment="TOP_CENTER"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Título -->
    <Label text="Usuario Temporal" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="150"/>
            <ColumnConstraints minWidth="300"/>
        </columnConstraints>

        <Label text="ID Usuario" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nombre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Teléfono" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="telefonoField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Correo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="correoField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Placas del vehículo" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="placasField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Agregar Documento" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <TextField fx:id="documentoField" promptText="AGREGAR DOCUMENTO" />
            <Button text="📎"/>
        </HBox>
    </GridPane>

    <HBox spacing="30" alignment="CENTER">
        <Button text="GUARDAR" style="-fx-background-color: black; -fx-text-fill: white;" onAction="#handleGuardar"/>
        <Button text="CANCELAR" style="-fx-background-color: black; -fx-text-fill: white;" onAction="#handleCancelar"/>
    </HBox>
</VBox>
