<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="592.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.placaspt.ui.AgregarUsuarios">
   <children>
      <Button layoutX="67.0" layoutY="483.0" mnemonicParsing="false" onAction="#onBack" text="Regresar" />
      <Button fx:id="btnAgregar" layoutX="213.0" layoutY="483.0" mnemonicParsing="false" onAction="#onGuardar" text="Agregar Usuario" />
      <TextField fx:id="usuarioNombreTf" layoutX="41.0" layoutY="62.0" promptText="Nombre" />
      <TextField fx:id="usuarioApellidosTf" layoutX="353.0" layoutY="62.0" promptText="Apellido" />
      <Label layoutX="46.0" layoutY="45.0" text="Nombre *" />
      <Label layoutX="43.0" layoutY="107.0" text="Correo Electronico *" />
      <TextField fx:id="usuarioCorreoTf" layoutX="41.0" layoutY="134.0" promptText="ejemplo@gmail.com" />
      <Label layoutX="353.0" layoutY="107.0" text="Teléfono *" />
      <TextField fx:id="usuarioTelefonoTf" layoutX="353.0" layoutY="134.0" promptText="55********" />
      <RadioButton fx:id="rbUsuarioFijo" layoutX="116.0" layoutY="14.0" mnemonicParsing="false" text="Usuario FIjo" />
      <RadioButton fx:id="rbUsuarioTemporal" layoutX="353.0" layoutY="14.0" mnemonicParsing="false" text="Usuario Temporal" />
      <AnchorPane fx:id="paneUsuarioTemporal" layoutY="282.0" prefHeight="176.0" prefWidth="600.0">
         <children>
            <Label layoutX="45.0" layoutY="21.0" text="Actividad a realizar" />
            <TextField fx:id="usuarioTempActividad" layoutX="39.0" layoutY="47.0" promptText="Visita" />
            <Label layoutX="55.0" layoutY="108.0" text="Fecha de Inicio" />
            <Button fx:id="btnCargarFoto" layoutX="300.0" layoutY="47.0" mnemonicParsing="false" text="Agregar Foto" />
            <Label layoutX="281.0" layoutY="21.0" text="Agrega una foto del DNI" />
            <ImageView fx:id="dniPreview" fitHeight="50.0" fitWidth="138.0" layoutX="444.0" layoutY="35.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons/add_doc.png" />
               </image>
            </ImageView>
            <DatePicker fx:id="fechaInicio" layoutX="26.0" layoutY="135.0" />
            <Label layoutX="313.0" layoutY="108.0" text="Fecha de Fin" />
            <DatePicker fx:id="fechaFin" layoutX="291.0" layoutY="135.0" />
         </children>
      </AnchorPane>
      <Label layoutX="451.0" layoutY="487.0" text="Estado" />
      <TitledPane expanded="false" layoutX="25.0" layoutY="170.0" prefHeight="200.0" prefWidth="510.0" text="Asignar tarjeta RFID" />
   </children>
</AnchorPane>
