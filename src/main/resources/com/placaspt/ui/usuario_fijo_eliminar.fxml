<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox spacing="20" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.placaspt.ui.UsuarioFijoEliminarController"
      stylesheets="@usuario_form.css"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Eliminar Usuario Fijo" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="150"/>
            <ColumnConstraints minWidth="300"/>
        </columnConstraints>

        <Label text="ID Usuario" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <TextField fx:id="idUsuarioField" promptText="ID del usuario"/>
            <Button text="BUSCAR" onAction="#handleBuscar"/>
        </HBox>

        <Label text="Nombre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Teléfono" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="telefonoField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Placas del vehículo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="placasField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Modelo del vehículo" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="modeloField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Tarjeta RFID" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="rfidField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="20" alignment="CENTER">
        <Button text="ELIMINAR" onAction="#handleEliminar" styleClass="btn-agregar"/>
        <Button text="CANCELAR" onAction="#handleCancelar" styleClass="btn-cancelar"/>
    </HBox>
</VBox>
