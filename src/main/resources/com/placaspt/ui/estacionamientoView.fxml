<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="rootPane" prefHeight="601.0" prefWidth="1020.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.placaspt.ui.EstacionamientoController">
   <children>
      <VBox spacing="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
         <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Estacionamiento" />
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label fx:id="lblOcupados" text="Espacios ocupados: 0 de 30" />
            <Label text="Fecha:" />
            <DatePicker fx:id="dpFecha" />
            <Label text="Buscar placa/usuario:" />
            <TextField fx:id="tfFiltro" promptText="ID, placa o nombre" />
            <Button fx:id="btnRefrescarPuerto" mnemonicParsing="false" onAction="#refrescarPuerto" text="Refrescar COM" />
            <Circle fx:id="statusCircle" fill="DODGERBLUE" radius="9.0" stroke="BLACK" strokeType="INSIDE" />
         </HBox>
      </VBox>
      <HBox layoutX="629.0" layoutY="101.0" prefHeight="499.0" prefWidth="271.0" spacing="15.0" AnchorPane.bottomAnchor="11.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="11.0" AnchorPane.topAnchor="95.0">
         <children>
            <TableView fx:id="tblAccesos" prefHeight="494.0" prefWidth="850.0" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colFechaHora" prefWidth="150" text="FechaHora" />
                  <TableColumn fx:id="colUsuario" prefWidth="150" text="Usuario" />
                  <TableColumn fx:id="colPlaca" prefWidth="100" text="Placa" />
                  <TableColumn fx:id="colMetodo" prefWidth="100" text="Método" />
                  <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                  <TableColumn fx:id="colAccion" prefWidth="120" text="Acción" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <HBox.margin>
                  <Insets bottom="1.0" />
               </HBox.margin>
            </TableView>
            <Pane fx:id="statusRect" prefHeight="200.0" prefWidth="0.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="statusLabel" layoutX="15.0" layoutY="171.0" text="Evento" />
               </children>
            </Pane>
         </children>
      </HBox>
   </children>
</AnchorPane>
