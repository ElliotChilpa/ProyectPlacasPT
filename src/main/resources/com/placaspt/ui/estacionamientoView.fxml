<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="rootPane" prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.placaspt.ui.EstacionamientoController">
   <children>
      <VBox spacing="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
         <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Estacionamiento" />
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label fx:id="lblOcupados" text="Espacios ocupados: 0 de 30" />
            <Label text="Fecha:" />
            <DatePicker fx:id="dpFecha" />
            <Label text="Buscar placa/usuario:" />
            <TextField fx:id="tfFiltro" promptText="ID, placa o nombre" />
            <Button fx:id="btnRefrescarPuerto" mnemonicParsing="false" onAction="#refrescarPuerto" text="Refrescar COM" />
            <Circle fx:id="statusCircle" fill="DODGERBLUE" radius="9.0" stroke="BLACK" strokeType="INSIDE" />
         </HBox>
      </VBox>
      <TableView fx:id="tblAccesos" layoutX="11.2" layoutY="95.2" prefHeight="495.0" prefWidth="879.0" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="95.0">
         <columns>
            <TableColumn fx:id="colFechaHora" prefWidth="150" text="FechaHora" />
            <TableColumn fx:id="colUsuario" prefWidth="150" text="Usuario" />
            <TableColumn fx:id="colPlaca" prefWidth="100" text="Placa" />
            <TableColumn fx:id="colMetodo" prefWidth="100" text="Método" />
            <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
            <TableColumn fx:id="colAccion" prefWidth="120" text="Acción" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
